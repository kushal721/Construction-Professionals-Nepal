PORT=4000
DATABASE_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=construction-professionals-nepal
JWT_SECRET_KEY=change_me_to_a_long_random_string

# Comma-separated list of allowed frontend origins (CORS + links in emails)
REACT_FRONTEND=http://localhost:5173

# Optional SMTP. When unset, password-reset emails are printed to the console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# Where contact-form messages are sent (defaults to EMAIL_FROM)
CONTACT_EMAIL=
